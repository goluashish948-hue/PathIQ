# Server Configuration
PORT=5001
NODE_ENV=development
API_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# Database (SQLite default for frictionless zero-docker setup; or PostgreSQL for prod)
DATABASE_URL="file:./dev.db"

# Security
JWT_SECRET=super_secret_jwt_key_pathiq_production_or_dev_change_in_real_world_8492
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# AI Gateway Configuration
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-gps-pro-model
AI_MODEL_FAST=mock-gps-fast-model
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Storage Driver (local | s3 | minio)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pathiq-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email Driver (mock | mailhog | smtp)
EMAIL_DRIVER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@pathiq.dev

# Sandbox
SANDBOX_MODE=disposable-sqlite
