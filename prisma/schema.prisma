// Prisma schema mirror at root
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             @default("STUDENT")
  ageConfirmed      Boolean            @default(true)
  isUnder18         Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  avatarUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  studentProfile    StudentProfile?
  careerTwin        CareerTwin?
  roadmaps          Roadmap[]
  resumes           Resume[]
  portfolio         Portfolio?
  mentorConvs       MentorConversation[]
  interviews        Interview[]
  proofSubmissions  ProofSubmission[]
  capstoneSubmissions CapstoneSubmission[]
  dailyPlans        DailyPlan[]
  notifications     Notification[]
  notificationPref  NotificationPref?
  streaks           Streak?
  badges            Badge[]
  auditLogs         AuditLog[]
  dataRequests      DataRequest[]
  safetyEvents      SafetyEvent[]
}

model StudentProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel    String?
  courseDegree      String?
  yearSemester      String?
  targetCareer      String?
  targetDomain      String?
  availableWeeklyHours Int       @default(10)
  learningPreference String      @default("mixed")
  preferredLanguage String       @default("en")
  bio               String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  educations        Education[]
  experiences       Experience[]
  certifications    Certification[]
  studentSkills     StudentSkill[]
  projects          Project[]
}

model Education {
  id               String          @id @default(uuid())
  profileId        String
  profile          StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution      String
  degree           String
  fieldOfStudy     String?
  startYear        Int?
  endYear          Int?
  gradeGpa         String?
}

model Experience {
  id               String          @id @default(uuid())
  profileId        String
  profile          StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  company          String
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean         @default(false)
  description      String?
}

model Certification {
  id               String          @id @default(uuid())
  profileId        String
  profile          StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name             String
  issuer           String
  issueDate        DateTime?
  credentialUrl    String?
  isVerified       Boolean         @default(false)
}

model Domain {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  description      String
  icon             String?
  skillsCount      Int             @default(0)
  rolesCount       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  domainPacks      DomainPack[]
  skills           Skill[]
  occupations      Occupation[]
}

model DomainPack {
  id               String               @id @default(uuid())
  domainId         String
  domain           Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)
  version          String               @default("1.0.0")
  isActive         Boolean              @default(true)
  packData         String
  reviewedByAdmin  Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  versions         DomainPackVersion[]
}

model DomainPackVersion {
  id               String          @id @default(uuid())
  packId           String
  pack             DomainPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  version          String
  changesSummary   String?
  packData         String
  createdAt        DateTime        @default(now())
}

model Skill {
  id               String          @id @default(uuid())
  name             String          @unique
  domainId         String?
  domain           Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  description      String
  type             String          @default("technical")
  level0Desc       String?
  level1Desc       String?
  level2Desc       String?
  level3Desc       String?
  level4Desc       String?
  createdAt        DateTime        @default(now())

  aliases          SkillAlias[]
  studentSkills    StudentSkill[]
  fromRelations    SkillRelation[] @relation("FromSkill")
  toRelations      SkillRelation[] @relation("ToSkill")
  occupationSkills OccupationSkill[]
}

model SkillAlias {
  id               String          @id @default(uuid())
  skillId          String
  skill            Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias            String          @unique
}

model SkillRelation {
  id               String          @id @default(uuid())
  fromSkillId      String
  toSkillId        String
  fromSkill        Skill           @relation("FromSkill", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill          Skill           @relation("ToSkill", fields: [toSkillId], references: [id], onDelete: Cascade)
  relationType     String
  transferFactor   Float           @default(1.0)
}

model Occupation {
  id               String          @id @default(uuid())
  title            String          @unique
  domainId         String?
  domain           Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  description      String
  responsibilities String?
  seniorityLevels  String?
  relatedRoles     String?
  createdAt        DateTime        @default(now())

  skills           OccupationSkill[]
}

model OccupationSkill {
  id               String          @id @default(uuid())
  occupationId     String
  skillId          String
  occupation       Occupation      @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skill            Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  importance       String          @default("MUST_HAVE")
  targetLevel      Int             @default(2)
  frequencyPercent Float           @default(80.0)
}

model JobPosting {
  id               String          @id @default(uuid())
  title            String
  company          String?
  source           String          @default("corpus")
  rawText          String
  textHash         String
  seniority        String?
  domain           String?
  extractedSkills  String
  licenseInfo      String?
  isSynthetic      Boolean         @default(false)
  postedAt         DateTime        @default(now())
  createdAt        DateTime        @default(now())
}

model JobStats {
  id               String          @id @default(uuid())
  roleKey          String          @unique
  sampleSize       Int             @default(0)
  statsData        String
  lastCalculatedAt DateTime        @default(now())
}

model GoalAnalysis {
  id               String          @id @default(uuid())
  userId           String?
  inputGoal        String
  specificity      String
  detectedDomain   String
  detectedRole     String
  suggestions      String
  createdAt        DateTime        @default(now())
}

model JobDna {
  id               String          @id @default(uuid())
  roleKey          String          @unique
  domain           String
  summary          String
  responsibilities String
  mustHaveSkills   String
  goodToHaveSkills String
  differentiators  String
  typicalProjects  String
  sourcesSummary   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model JdAnalysis {
  id               String          @id @default(uuid())
  userId           String?
  rawText          String
  targetRole       String?
  extractedSkills  String
  confidence       Float           @default(0.9)
  createdAt        DateTime        @default(now())
}

model CareerTwin {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallReadiness Float           @default(0.0)
  roadmapCompletion Float          @default(0.0)
  knowledgeScore   Float           @default(0.0)
  quizMasteryScore Float           @default(0.0)
  practicalScore   Float           @default(0.0)
  projectsScore    Float           @default(0.0)
  interviewScore   Float           @default(0.0)
  radarDimensions  String
  weaknesses       String
  strengths        String
  lastEventAt      DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  events           TwinEvent[]
  snapshots        TwinSnapshot[]
}

model TwinEvent {
  id               String          @id @default(uuid())
  twinId           String
  twin             CareerTwin      @relation(fields: [twinId], references: [id], onDelete: Cascade)
  eventType        String
  eventPayload     String
  createdAt        DateTime        @default(now())
}

model TwinSnapshot {
  id               String          @id @default(uuid())
  twinId           String
  twin             CareerTwin      @relation(fields: [twinId], references: [id], onDelete: Cascade)
  monthLabel       String
  overallReadiness Float
  metricsBreakdown String
  keyMilestones    String?
  createdAt        DateTime        @default(now())
}

model StudentSkill {
  id               String          @id @default(uuid())
  profileId        String
  profile          StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  declaredLevel    Int             @default(1)
  effectiveLevel   Float           @default(0.5)
  verificationState String         @default("SELF_REPORTED")
  evidenceType     String?
  evidenceRefId    String?
  verifiedAt       DateTime?
  lastPracticedAt  DateTime?
  updatedAt        DateTime        @updatedAt
}

model Roadmap {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCareer     String
  targetDomain     String
  trackType        String          @default("STRONG")
  weeklyHours      Int             @default(10)
  status           String          @default("ACTIVE")
  versionNumber    Int             @default(1)
  overallProgress  Float           @default(0.0)
  totalEstimatedHours Int          @default(120)
  isShareable      Boolean         @default(false)
  shareSlug        String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  nodes            RoadmapNode[]
  edges            RoadmapEdge[]
  versions         RoadmapVersion[]
  diffs            RoadmapDiff[]
}

model RoadmapVersion {
  id               String          @id @default(uuid())
  roadmapId        String
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  versionNumber    Int
  reason           String
  graphSnapshot    String
  createdAt        DateTime        @default(now())
}

model RoadmapDiff {
  id               String          @id @default(uuid())
  roadmapId        String
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  status           String          @default("PENDING")
  triggerReason    String
  explanation      String
  addedNodes       String
  removedNodes     String
  modifiedNodes    String
  scheduleDelta    String
  createdAt        DateTime        @default(now())
}

model RoadmapNode {
  id               String          @id @default(uuid())
  roadmapId        String
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodeKey          String
  title            String
  nodeType         String          @default("skill")
  importance       String          @default("MUST_HAVE")
  targetLevel      Int             @default(2)
  estimatedHours   Int             @default(10)
  orderIndex       Int             @default(0)
  scheduledWeek    Int             @default(1)
  learningObjectives String
  whyNeeded        String
  practiceTasks    String?
  quizConfig       String?
  proofRequirement String?
  resourceIds      String?
  status           String          @default("LOCKED")
  completedAt      DateTime?
  clusterGroup     String?

  topicsProgress   TopicProgress[]
}

model RoadmapEdge {
  id               String          @id @default(uuid())
  roadmapId        String
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sourceNodeKey    String
  targetNodeKey    String
}

model DailyPlan {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime        @default(now())
  allocatedMinutes Int             @default(120)
  completedMinutes Int             @default(0)
  createdAt        DateTime        @default(now())

  blocks           DailyPlanBlock[]
}

model DailyPlanBlock {
  id               String          @id @default(uuid())
  planId           String
  plan             DailyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  title            String
  nodeKey          String?
  durationMinutes  Int             @default(45)
  category         String          @default("learn")
  isCompleted      Boolean         @default(false)
  whyLearningThis  String?
  orderIndex       Int             @default(0)
}

model TimeLog {
  id               String          @id @default(uuid())
  userId           String
  nodeKey          String?
  category         String
  minutesSpent     Int
  loggedAt         DateTime        @default(now())
}

model TopicProgress {
  id               String          @id @default(uuid())
  nodeId           String
  node             RoadmapNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  topicKey         String
  title            String
  progressStatus   String          @default("NOT_STARTED")
  notes            String?
  completedAt      DateTime?
}

model LearnContent {
  id               String          @id @default(uuid())
  topicKey         String          @unique
  title            String
  concepts         String
  examples         String
  commonMistakes   String
  checkQuestions   String
  estimatedTimeMin Int             @default(45)
  isAiGenerated    Boolean         @default(true)
  updatedAt        DateTime        @updatedAt
}

model QuizBank {
  id               String          @id @default(uuid())
  topicKey         String
  difficulty       String
  isVerifiedBySecondPass Boolean   @default(true)
  createdAt        DateTime        @default(now())

  questions        QuizQuestion[]
}

model QuizQuestion {
  id               String          @id @default(uuid())
  bankId           String
  bank             QuizBank        @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type             String          @default("MCQ")
  questionText     String
  options          String
  correctAnswer    String
  explanation      String
  rubric           String?
  isFlagged        Boolean         @default(false)
  flagReason       String?
}

model QuizAttempt {
  id               String          @id @default(uuid())
  userId           String
  nodeKey          String
  topicKey         String
  difficulty       String
  score            Int             @default(0)
  totalQuestions   Int             @default(10)
  percentage       Float           @default(0.0)
  passed           Boolean         @default(false)
  answersPayload   String
  attemptedAt      DateTime        @default(now())
}

model MasteryRecord {
  id               String          @id @default(uuid())
  userId           String
  topicKey         String
  masteryScore     Float           @default(0.0)
  attemptCount     Int             @default(0)
  isMastered       Boolean         @default(false)
  nextRevisionAt   DateTime?
  revisionStage    Int             @default(0)
  updatedAt        DateTime        @updatedAt

  @@unique([userId, topicKey])
}

model ProofTemplate {
  id               String          @id @default(uuid())
  taskKey          String          @unique
  domain           String
  title            String
  description      String
  proofType        String
  instructions     String
  rubric           String
  sandboxConfig    String?
  difficulty       String          @default("INTERMEDIATE")
  associatedSkill  String

  submissions      ProofSubmission[]
}

model ProofSubmission {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId       String
  template         ProofTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissionPayload String
  artifactUrl      String?
  evaluationMode   String          @default("AUTO_GRADED")
  score            Float           @default(0.0)
  passed           Boolean         @default(false)
  feedback         String?
  submittedAt      DateTime        @default(now())
}

model Project {
  id               String          @id @default(uuid())
  profileId        String
  profile          StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  skillsUsed       String
  repoUrl          String?
  liveUrl          String?
  analysisScore    Float?
  analysisReport   String?
  createdAt        DateTime        @default(now())
}

model Capstone {
  id               String          @id @default(uuid())
  roleKey          String          @unique
  domain           String
  title            String
  problemStatement String
  requirements     String
  milestones       String
  acceptanceRubric String
  suggestedDatasets String
  deliverables     String
  createdAt        DateTime        @default(now())

  submissions      CapstoneSubmission[]
}

model CapstoneSubmission {
  id               String          @id @default(uuid())
  capstoneId       String
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  capstone         Capstone        @relation(fields: [capstoneId], references: [id], onDelete: Cascade)
  repoUrl          String?
  liveUrl          String?
  documentation    String?
  analysisReport   String?
  verifiedScore    Float?
  status           String          @default("SUBMITTED")
  submittedAt      DateTime        @default(now())
}

model Interview {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCareer     String
  type             String          @default("TECHNICAL")
  overallScore     Float?
  status           String          @default("IN_PROGRESS")
  report           String?
  createdAt        DateTime        @default(now())

  turns            InterviewTurn[]
}

model InterviewTurn {
  id               String          @id @default(uuid())
  interviewId      String
  interview        Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turnIndex        Int
  interviewerText  String
  candidateResponse String?
  evaluation       String?
  createdAt        DateTime        @default(now())
}

model Resume {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionName      String          @default("Primary Resume")
  targetCareer     String?
  isDefault        Boolean         @default(true)
  atsScore         Float           @default(0.0)
  strengthScore    String
  summary          String?
  contentPayload   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Portfolio {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String          @unique
  isPublic         Boolean         @default(false)
  title            String?
  bio              String?
  sectionsConfig   String
  allowIndexSearch Boolean         @default(false)
  updatedAt        DateTime        @updatedAt
}

model ResourceLibrary {
  id               String          @id @default(uuid())
  title            String
  provider         String
  url              String          @unique
  type             String          @default("interactive")
  cost             String          @default("free")
  language         String          @default("en")
  associatedSkills String
  level            String          @default("BEGINNER")
  estimatedTimeMin Int             @default(60)
  isAdminApproved  Boolean         @default(true)
  isLinkValid      Boolean         @default(true)
  lastCheckedAt    DateTime        @default(now())
}

model MentorConversation {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String          @default("Career Mentorship")
  summary          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  messages         MentorMessage[]
}

model MentorMessage {
  id               String              @id @default(uuid())
  conversationId   String
  conversation     MentorConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           String
  text             String
  citations        String?
  proposedAction   String?
  actionStatus     String?
  createdAt        DateTime            @default(now())
}

model MarketAlert {
  id               String          @id @default(uuid())
  roleKey          String
  title            String
  description      String
  sampleSize       Int
  significanceScore Float
  evidenceData     String
  suggestedAction  String?
  isActive         Boolean         @default(true)
  detectedAt       DateTime        @default(now())
}

model Notification {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  title            String
  body             String
  actionUrl        String?
  isRead           Boolean         @default(false)
  createdAt        DateTime        @default(now())
}

model NotificationPref {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled     Boolean         @default(true)
  inAppEnabled     Boolean         @default(true)
  quietHoursStart  Int?
  quietHoursEnd    Int?
}

model Streak {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int             @default(0)
  longestStreak    Int             @default(0)
  lastActivityDate DateTime?
  freezesRemaining Int             @default(2)
}

model Badge {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey         String
  title            String
  description      String
  icon             String
  earnedAt         DateTime        @default(now())
}

model AiCall {
  id               String          @id @default(uuid())
  promptName       String
  templateVersion  String          @default("1.0.0")
  provider         String          @default("mock")
  model            String
  inputHash        String
  tokensUsed       Int             @default(0)
  latencyMs        Int             @default(150)
  validationPassed Boolean         @default(true)
  errorMessage     String?
  createdAt        DateTime        @default(now())
}

model SafetyEvent {
  id               String          @id @default(uuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType        String
  rawInputSnippet  String?
  actionTaken      String
  createdAt        DateTime        @default(now())
}

model AuditLog {
  id               String          @id @default(uuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  details          String?
  ipAddress        String?
  createdAt        DateTime        @default(now())
}

model DataRequest {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType      String
  status           String          @default("PENDING")
  resultUrl        String?
  createdAt        DateTime        @default(now())
}
