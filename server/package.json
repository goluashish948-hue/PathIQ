{
  "name": "pathiq-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev --name init || prisma db push",
    "db:push": "prisma db push",
    "seed": "tsx src/scripts/seed.ts",
    "import:jobs": "tsx src/scripts/import-jobs.ts",
    "import:ontology": "tsx src/scripts/import-ontology.ts",
    "check:links": "tsx src/scripts/check-links.ts",
    "validate:packs": "tsx src/scripts/validate-packs.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "tsx src/tests/run-all-tests.ts",
    "test:safety": "tsx src/tests/safety.test.ts",
    "test:golden": "tsx src/tests/golden.test.ts",
    "test:e2e": "tsx src/tests/e2e.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/pdfkit": "^0.13.8",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
