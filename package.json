{
  "name": "pathiq-ai-career-gps",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Adaptive Career Navigation Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server",
    "import:jobs": "npm run import:jobs --workspace=server",
    "import:ontology": "npm run import:ontology --workspace=server",
    "check:links": "npm run check:links --workspace=server",
    "validate:packs": "npm run validate:packs --workspace=server",
    "create-admin": "npm run create-admin --workspace=server",
    "test": "npm run test --workspace=server",
    "test:safety": "npm run test:safety --workspace=server",
    "test:golden": "npm run test:golden --workspace=server",
    "test:e2e": "npm run test:e2e --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
